diff --git a/public/script.js b/public/script.js
--- a/public/script.js
+++ b/public/script.js
@@ -701,6 +701,43 @@ async function firstLoadInit() {
         throw new Error('Initialization failed');
     }
 
+    const gptWebQuery = new URLSearchParams(location.search).get('gptweb');
+    const gptWebSettings = JSON.parse(localStorage.getItem('gpt-web:settings') || '{}');
+    const gptWebBootstrapEnabled = gptWebQuery === 'on' || (gptWebQuery !== 'off' && gptWebSettings.enabled !== false);
+    if (gptWebBootstrapEnabled) {
+        const gptWebTheme = gptWebSettings.theme === 'dark' || ((gptWebSettings.theme || 'system') === 'system' && matchMedia('(prefers-color-scheme: dark)').matches)
+            ? 'dark'
+            : gptWebSettings.theme === 'tavern' ? 'tavern' : 'light';
